{
  // Cloudflare Worker for updates.pollis.com — the Expo Updates server behind the
  // mobile app's over-the-air JS updates (#1250). Its own Worker and its own R2
  // bucket, in the same Cloudflare account as everything else; it never shares
  // a binding with the release bucket (cdn.pollis.com) or the DS.
  //
  // Deploy (owner, manual — see docs/deployments.md "Mobile OTA updates"):
  //   pnpm --filter pollis-updates-worker exec wrangler deploy -c wrangler.jsonc
  // Dry run (no account needed):
  //   pnpm --filter pollis-updates-worker exec wrangler deploy -c wrangler.jsonc --dry-run --outdir /tmp/pollis-updates
  //
  // The Worker holds NO secret. The code-signing key lives only in the
  // `ota-signing` GitHub environment (behind a required reviewer); this Worker
  // serves pre-signed bytes it cannot alter without breaking their signature.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pollis-updates",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-08",
  // Reachable only on its custom domain: no *.workers.dev alias and no
  // per-version preview URLs, so there is exactly one origin to reason about.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "updates.pollis.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "UPDATES", "bucket_name": "pollis-updates" }],
  "vars": {
    // The only channel this deployment answers for. A build sends it as
    // `expo-channel-name` (mobile/app.config.js); any other value gets a 400.
    "CHANNEL": "production"
  },
  // No plain client IPs readable anywhere, admins included — the same rule and
  // the same two switches as the DS (pollis-delivery/wrangler.prod.jsonc).
  // Workers Logs would record every request's headers and `cf` object (the
  // client IP) in the dashboard; Logpush would export them. Both OFF,
  // explicitly, so every deploy resets them whatever the dashboard says.
  // Pinned by tests/no-client-ip.test.ts. A live `wrangler tail` is an account
  // permission config cannot remove; nobody runs it against this Worker.
  "observability": { "enabled": false },
  "logpush": false
}
