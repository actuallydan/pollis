{
  "name": "pollis-updates-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker serving signed Expo Updates (OTA) manifests and assets for the Pollis mobile app",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy": "wrangler deploy -c wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy -c wrangler.jsonc --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.107.1"
  }
}
